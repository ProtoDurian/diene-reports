{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diene-reports",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "reports.atomi.cloud", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diene_reports",
      "database_id": "463c9bac-575d-4b46-98f9-28bca68b3e2f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "diene-reports" }],
  "vars": {
    "ALLOWED_OWNER_IDS": "349664883,55664364",
    "OIDC_AUDIENCE": "diene-reports",
    "PUBLIC_BASE_URL": "https://reports.atomi.cloud",
    "ACCESS_TEAM_DOMAIN": "https://atomicloud.cloudflareaccess.com",
    "ACCESS_AUD": "ab2d52e241e575a8c4df3db1476312906c0e85dc63f675880faa9b15a44423df"
  },
  "triggers": { "crons": ["*/15 * * * *", "17 3 * * *"] },
  "observability": { "enabled": true }
}
